---
import SellerProfileLoader from "../../presentation/components/SellerProfileLoader.vue";
import BottomNav from "../../presentation/components/BottomNav.vue";
import Header from "../../presentation/components/Header.astro";
import "../../styles/global.css";

export const prerender = false;

const { id } = Astro.params;

if (!id) {
  return Astro.redirect("/404");
}

const marketplaceName = import.meta.env.PUBLIC_MARKETPLACE_NAME || "Naya";
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Perfil - {marketplaceName}</title>
  </head>
  <body class="bg-[#FDFCFB] min-h-screen pb-24 lg:pb-8">
    <Header leftAction="back" rightAction="cart" />

    <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6 sm:py-8 lg:py-12">
      <SellerProfileLoader client:only="vue" id={id} />
    </main>

    <BottomNav client:only="vue" />
  </body>
</html>
