---
import { FirestoreCategoryRepository } from '../infrastructure/repositories/FirestoreCategoryRepository';
import { FirestoreUserRepository } from '../infrastructure/repositories/FirestoreUserRepository';
import { GetCategories } from '../application/use-cases/GetCategories';
import { GetSellers } from '../application/use-cases/GetSellers';
import type { Category } from '../domain/entities/Category';
import type { User } from '../domain/entities/User';
import BottomNav from '../presentation/components/BottomNav.vue';
import Header from '../presentation/components/Header.astro';
import '../styles/global.css';

const categoryRepo = new FirestoreCategoryRepository();
const userRepo = new FirestoreUserRepository();
const getCategories = new GetCategories(categoryRepo);
const getSellers = new GetSellers(userRepo);

let categories: Category[] = [];
let sellers: User[] = [];

try {
  [categories, sellers] = await Promise.all([
    getCategories.execute(),
    getSellers.execute(),
  ]);
} catch (e) {
  console.error("Error fetching home data:", e);
}

const marketplaceName = import.meta.env.PUBLIC_MARKETPLACE_NAME || 'Nayah';
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
    <title>{marketplaceName} - Marketplace</title>
  </head>
  <body class="bg-[#FDFCFB] min-h-screen pb-24 lg:pb-8">
    <Header leftAction="search" rightAction="cart" />

    <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6 sm:py-8">

      <!-- Tabs -->
      <div class="flex gap-2 mb-6">
        <button
          id="tab-perfiles"
          class="tab-btn tab-active px-5 py-2 rounded-full text-sm font-bold tracking-wide transition-all"
          onclick="switchTab('perfiles')"
        >
          PERFILES
        </button>
        <button
          id="tab-categorias"
          class="tab-btn px-5 py-2 rounded-full text-sm font-bold tracking-wide transition-all"
          onclick="switchTab('categorias')"
        >
          CATEGORÍAS
        </button>
      </div>

      <!-- Panel: Perfiles (vendedoras) -->
      <div id="panel-perfiles">
        {sellers.length === 0 ? (
          <div class="grid grid-cols-3 sm:grid-cols-4 lg:grid-cols-6 gap-2 sm:gap-3">
            {Array.from({ length: 12 }).map(() => (
              <div class="w-full aspect-square bg-gray-200 rounded-xl animate-pulse" />
            ))}
          </div>
        ) : (
          <div class="grid grid-cols-3 sm:grid-cols-4 lg:grid-cols-6 gap-2 sm:gap-3">
            {sellers.map((seller) => {
              const name = seller.displayName || seller.name || '';
              const href = `/sellers/${seller.id}`;
              return (
                <a
                  href={href}
                  class="relative block w-full aspect-square overflow-hidden rounded-xl shadow-sm active:scale-[0.97] transition-transform"
                  aria-label={`Ver perfil de ${name}`}
                >
                  {seller.photoURL ? (
                    <img
                      src={seller.photoURL}
                      alt={name}
                      class="w-full h-full object-cover"
                    />
                  ) : (
                    <div class="w-full h-full bg-gray-200 flex items-center justify-center">
                      <span class="text-gray-400 text-2xl font-bold">
                        {name.charAt(0).toUpperCase()}
                      </span>
                    </div>
                  )}
                  <div class="absolute inset-0 bg-gradient-to-t from-black/70 via-black/10 to-transparent" />
                  <span class="absolute bottom-1.5 left-2 right-1 text-white text-[10px] sm:text-xs font-bold leading-tight uppercase tracking-wide line-clamp-2">
                    {name}
                  </span>
                </a>
              );
            })}
          </div>
        )}
      </div>

      <!-- Panel: Categorías -->
      <div id="panel-categorias" class="hidden">
        {categories.length === 0 ? (
          <div class="grid grid-cols-3 sm:grid-cols-4 lg:grid-cols-6 gap-2 sm:gap-3">
            {Array.from({ length: 12 }).map(() => (
              <div class="w-full rounded-xl animate-pulse bg-gray-200" style="aspect-ratio: 2/3;" />
            ))}
          </div>
        ) : (
          <div class="grid grid-cols-3 sm:grid-cols-4 lg:grid-cols-6 gap-2 sm:gap-3">
            {categories.map((cat) => {
              const routeKey = cat.slug || cat.name;
              return (
                <a
                  href={`/categories/${encodeURIComponent(routeKey)}`}
                  class="relative block w-full overflow-hidden rounded-xl shadow-sm active:scale-[0.97] transition-transform"
                  style="aspect-ratio: 2/3;"
                  aria-label={`Ver ${cat.name}`}
                >
                  {cat.image ? (
                    <img
                      src={cat.image}
                      alt={cat.name}
                      class="w-full h-full object-cover"
                    />
                  ) : (
                    <div class="w-full h-full bg-gray-200 flex items-center justify-center">
                      <span class="text-gray-400 text-xs">Sin imagen</span>
                    </div>
                  )}
                  <div class="absolute inset-0 bg-gradient-to-t from-black/70 via-black/10 to-transparent" />
                  <span class="absolute bottom-1.5 left-2 right-1 text-white text-[10px] sm:text-xs font-bold leading-tight uppercase tracking-wide line-clamp-2">
                    {cat.name}
                  </span>
                </a>
              );
            })}
          </div>
        )}
      </div>

    </main>

    <BottomNav client:only="vue" />

    <style>
      .tab-btn {
        background: transparent;
        border: 2px solid #d1cdc7;
        color: #6b6b6b;
        cursor: pointer;
      }
      .tab-btn.tab-active {
        background: #1a1a1a;
        border-color: #1a1a1a;
        color: #ffffff;
      }
    </style>

    <script>
      function switchTab(tab: string) {
        const perfiles = document.getElementById('panel-perfiles') as HTMLElement;
        const categorias = document.getElementById('panel-categorias') as HTMLElement;
        const btnPerfiles = document.getElementById('tab-perfiles') as HTMLElement;
        const btnCategorias = document.getElementById('tab-categorias') as HTMLElement;

        if (tab === 'perfiles') {
          perfiles.classList.remove('hidden');
          categorias.classList.add('hidden');
          btnPerfiles.classList.add('tab-active');
          btnCategorias.classList.remove('tab-active');
        } else {
          perfiles.classList.add('hidden');
          categorias.classList.remove('hidden');
          btnCategorias.classList.add('tab-active');
          btnPerfiles.classList.remove('tab-active');
        }
      }
    </script>

  </body>
</html>
