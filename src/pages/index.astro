---
import BottomNav from '../presentation/components/BottomNav.vue';
import HomeBrowse from '../presentation/components/HomeBrowse.vue';
import Header from '../presentation/components/Header.astro';
import '../styles/global.css';

export const prerender = true;

const marketplaceName = import.meta.env.PUBLIC_MARKETPLACE_NAME || 'Nayah';
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Jomhuria&display=swap" rel="stylesheet" />
    <title>{marketplaceName} - Marketplace</title>
  </head>
  <body class="bg-[#FDFCFB] min-h-screen pb-24 lg:pb-8">
    <Header leftAction="search" rightAction="cart" />

    <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6 sm:py-8">
      <HomeBrowse client:load />
    </main>

    <BottomNav client:only="vue" />
  </body>
</html>
