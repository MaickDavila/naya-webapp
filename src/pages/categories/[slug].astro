---
import BottomNav from '../../presentation/components/BottomNav.vue';
import Header from '../../presentation/components/Header.astro';
import CategoryPageView from '../../presentation/components/CategoryPageView.vue';
import '../../styles/global.css';

export const prerender = false;

const { slug } = Astro.params;
const marketplaceName = import.meta.env.PUBLIC_MARKETPLACE_NAME || 'Naya';
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
    <title>Categoría - {marketplaceName}</title>
  </head>
  <body class="bg-[#FDFCFB] min-h-screen pb-24 lg:pb-8">
    <Header leftAction="back-home" rightAction="cart" />

    <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6 sm:py-8 lg:py-12">
      <CategoryPageView client:only="vue" slug={slug ?? ''} />
    </main>

    <BottomNav client:only="vue" />
  </body>
</html>
